{
  "name": "actionsshapinner",
  "version": "1.0.0",
  "description": "A tool that adds SHA to GitHub Actions",
  "main": "dist/index.js",
  "bin": {
    "sha-pinner": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "start": "ts-node src/index.ts"
  },
  "keywords": ["github-actions", "security", "sha", "pinning"],
  "author": "",
  "license": "GPL-2.0",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "js-yaml": "^4.1.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"],
    "collectCoverageFrom": ["src/**/*.ts", "!src/tests/**"]
  }
}
