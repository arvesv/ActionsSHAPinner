{
  "name": "actionsshapinner",
  "version": "1.0.0",
  "description": "CLI and library for pinning GitHub Actions uses: references to full commit SHAs.",
  "type": "commonjs",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "require": "./dist/lib.js",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sha-pinner": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "test": "jest",
    "start": "ts-node src/index.ts"
  },
  "keywords": [
    "github-actions",
    "security",
    "pinning",
    "supply-chain-security",
    "cli",
    "yaml"
  ],
  "author": "arvesv",
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arvesv/ActionsSHAPinner.git"
  },
  "bugs": {
    "url": "https://github.com/arvesv/ActionsSHAPinner/issues"
  },
  "homepage": "https://github.com/arvesv/ActionsSHAPinner#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "js-yaml": "^4.1.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/tests/**"
    ]
  }
}
